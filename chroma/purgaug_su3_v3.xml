<?xml version="1.0"?>
<!--
  purgaug_su3_v3.xml — SU(3) Wilson heatbath gauge generation TEMPLATE
  Used by run_batch_v3_su3.sh which substitutes __BETA__, __NWARMUP__, __NPROD__,
  __NUPDATES__, __SAVE_INTERVAL__, __SAVE_PREFIX__, __NROW__, __SEED1__.

  Reference: tests/purgaug/purgaug.ini.xml in JeffersonLab/chroma master.
  Action: standard Wilson gauge action (SU(3) plaquette, Nc=3).

  SU(3) Wilson β values (lattice spacing roughly 0.10-0.20 fm):
    β=5.85 (a ~ 0.16 fm)  - coarse
    β=5.95 (a ~ 0.12 fm)  - medium  (AT 2021 uses ~ this)
    β=6.05 (a ~ 0.10 fm)  - fine
  Three β values bracket the continuum a^2 -> 0 extrapolation window.

  Lattice 16^3 x 32: anisotropy preferred for glueball 0++/2++ since the
  temporal direction needs more time slices for plateau fits at the lighter
  2++. NROW = "16 16 16 32" (x y z t).

  NOTE: NO AnisoParam block - we use ISOTROPIC link action with rectangular
  geometry (longer t direction) instead of true Karsch anisotropy. This avoids
  the renormalization mess of ξ != 1 lattice. Same operator as AT 2021 baseline
  on N_t = 2*N_s isotropic boxes.
-->
<purgaug>

  <Cfg>
    <cfg_type>WEAK_FIELD</cfg_type>
    <cfg_file>dummy</cfg_file>
  </Cfg>

  <MCControl>
    <RNG>
      <Seed>
        <elem>__SEED1__</elem>
        <elem>0</elem>
        <elem>0</elem>
        <elem>0</elem>
      </Seed>
    </RNG>

    <StartUpdateNum>0</StartUpdateNum>
    <NWarmUpUpdates>__NWARMUP__</NWarmUpUpdates>
    <NProductionUpdates>__NPROD__</NProductionUpdates>
    <NUpdatesThisRun>__NUPDATES__</NUpdatesThisRun>
    <SaveInterval>__SAVE_INTERVAL__</SaveInterval>
    <SavePrefix>__SAVE_PREFIX__</SavePrefix>
    <SaveVolfmt>SINGLEFILE</SaveVolfmt>
  </MCControl>

  <InlineMeasurements>
    <!-- Polyakov loop is cheap, useful for confinement check -->
    <elem>
      <Name>POLYAKOV_LOOP</Name>
      <Frequency>10</Frequency>
      <Param><version>2</version></Param>
      <NamedObject><gauge_id>default_gauge_field</gauge_id></NamedObject>
    </elem>
    <!-- Plaquette is a cheap thermalization indicator -->
    <elem>
      <Name>PLAQUETTE</Name>
      <Frequency>10</Frequency>
      <Param><version>2</version></Param>
      <NamedObject><gauge_id>default_gauge_field</gauge_id></NamedObject>
    </elem>
  </InlineMeasurements>

  <HBItr>
    <GaugeAction>
      <Name>WILSON_GAUGEACT</Name>
      <beta>__BETA__</beta>
      <GaugeState>
        <Name>SIMPLE_GAUGE_STATE</Name>
        <GaugeBC><Name>PERIODIC_GAUGEBC</Name></GaugeBC>
      </GaugeState>
    </GaugeAction>
    <HBParams>
      <nOver>4</nOver>
      <NmaxHB>1</NmaxHB>
    </HBParams>
    <nrow>__NROW__</nrow>
  </HBItr>

</purgaug>
