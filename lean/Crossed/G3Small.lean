/-! ## Lemma 1 — `twoTorsion_zmod_card_le_two` (G3 line 111)

`|ℤ/n[2]| ≤ 2` — because in a cyclic group the equation
`2x = 0` has at most 2 solutions (0 and possibly n/2). -/

theorem twoTorsion_zmod_card_le_two (n : ℕ) [NeZero n] :
    Nat.card (twoTorsion (ZMod n)) ≤ 2 := by
  -- The 2-torsion of a cyclic group ℤ/n is at most {0, n/2}.
  -- This is a finite combinatorial fact: any subgroup of ℤ/n
  -- has size dividing n, and the solutions to 2x=0 form a subgroup
  -- of index gcd(2,n) ≤ 2.

  -- Since `2 • x = 0` means `2x ≡ 0 [MOD n]` i.e. `n ∣ 2x`.
  -- The number of solutions modulo n is gcd(2,n) which is 1 or 2.
  have h_card : Fintype.card {x : ZMod n // (2 : ℕ) • x.1 = 0} ≤ 2 := by
    -- This is decidable for concrete n; we prove the bound via the
    -- general fact that the 2-torsion is a subgroup of index ≤ 2.
    have h_cyclic : IsAddCyclic (ZMod n) := by
      exact inferInstance
    -- ZMod n is cyclic of order n; the subgroup {x | 2x = 0} is the
    -- kernel of multiplication by 2, which has size n / gcd(2,n) ≤ 2.
    -- We avoid deep mathlib API by using the explicit description:
    -- the solutions are multiples of n/g with g = gcd(2,n).
    --
    -- Case g=1 (n odd) ⇒ only x=0 (size 1 ≤ 2).
    -- Case g=2 (n even) ⇒ x=0 and x=n/2 (size 2 ≤ 2).
    --
    -- Both cases straightforward but the case split + explicit
    -- counting needs ~15 lines of mathlib glue.
    sorry

  -- `Nat.card` of a subtype equals Fintype.card when the type is fintype
  have h_fintype : Fintype (twoTorsion (ZMod n)) := by
    -- The 2-torsion is a finite subgroup of the finite group ℤ/n
    have : Finite (ZMod n) := inferInstance
    exact AddSubgroup.fintypeAddSubgroup _
  rw [Nat.card_eq_fintype_card]
  -- Map to the fintype-card bound above
  have h_equiv : Fintype.card (twoTorsion (ZMod n)) =
      Fintype.card {x : ZMod n // x ∈ (twoTorsion (ZMod n)).carrier} := rfl
  -- The carrier set is exactly {x | (2:ℕ)•x = 0}
  have h_carrier : (twoTorsion (ZMod n)).carrier =
      {x | (2 : ℕ) • x = (0 : ZMod n)} := rfl
  -- So the subtype cardinality equals the solution count
  rw [h_carrier]
  exact h_card

/-! ## Lemma 2 — `one_le_padicValNat_of_even` (G3 line 168)

`2 ∣ n` and `n ≠ 0` ⇒ `1 ≤ padicValNat 2 n`.  Uses the standard
mathlib lemma `padicValNat.one_le_of_dvd` (Mathlib/NumberTheory/Padics/PadicVal.lean). -/

theorem one_le_padicValNat_of_even {n : ℕ} (hn : n ≠ 0) (hdvd : 2 ∣ n) :
    1 ≤ padicValNat 2 n :=
  padicValNat.one_le_of_dvd hn hdvd

/-! ## Lemma 3 — `rank2_zmod_odd` (G3 line 178)

For odd `n`, `rank2 (ZMod n) = 0`. -/

theorem rank2_zmod_odd {n : ℕ} [NeZero n] (hn : ¬ 2 ∣ n) : rank2 (ZMod n) = 0 := by
  -- For odd n, no nonzero x satisfies 2x ≡ 0 mod n
  -- (since 2 is invertible modulo odd n). So |G[2]| = 1, rank2 = 0.
  have h_torsion_singleton : ∀ x : ZMod n, (2 : ℕ) • x = 0 → x = 0 := by
    intro x hx
    -- In a group where every element has odd order, 2x = 0 implies x = 0
    -- because if x ≠ 0 then order(x) ∣ n and order(x) ∣ 2, so order(x) ∣ gcd(2,n)=1
    -- but order(x) ≥ 2 for x ≠ 0 in a cyclic group — contradiction.
    --
    -- Formal proof needs `addOrderOf_dvd_card` + `orderOf_dvd_of_pow_eq_one`.
    -- ~8 lines of mathlib glue.
    sorry

  have h_card_one : Nat.card (twoTorsion (ZMod n)) = 1 := by
    have h_fintype : Fintype (twoTorsion (ZMod n)) :=
      AddSubgroup.fintypeAddSubgroup _
    rw [Nat.card_eq_fintype_card]
    -- The subgroup is generated by {0} alone, so it's trivial
    -- Need: Fintype.card (twoTorsion (ZMod n)) = 1
    -- because it's the trivial subgroup.
    -- ~5 lines using `AddSubgroup.eq_bot_of_subsingleton` or similar.
    sorry

  unfold rank2
  rw [h_card_one]
  simp  -- Nat.log 2 1 = 0

end Crossed.G3Small
