\begin{document}

\title{Mass Gap Formula for 4D Pure Yang--Mills\\
from Three Geometric Anchors and a\\
Bianchi-Cohomological Cross-Group Law}

\author{K\'evin R\'emondi\`ere}
\email{kevin.remondiere@gmail.com}
\affiliation{Independent Researcher, Oloron-Sainte-Marie, France\\
ORCID: \href{https://orcid.org/0009-0008-2443-7166}{0009-0008-2443-7166}}
\date{23 May 2026 (v4)}

\begin{abstract}
We derive a closed-form expression for the dimensionless mass-gap ratio
$m^{2}(J,P,C,\mathrm{ex},N)/\sigma_{0}$ in 4D pure $\mathrm{SU}(N)$
lattice Yang--Mills in which \emph{every} rational coefficient is
generated from three geometric anchors: the heat-kernel exponent
$\xistar = 2/3$ on $\mathbb{H}^{3}/\mathrm{PSL}_{2}(\mathcal{O}_{K})$
Bianchi orbifolds (Lean~4 proved), the Dijkgraaf--Witten genus
coefficient $\Finf = 9/10$ (Lean~4 proved), and the flux-tube flexion
energy unit $\delta=+2$ (structural empirical). Two further rationals
emerge as exact algebraic identities,
$\beta = 2+\Finf\xistar = 13/5$ and
$c_{\eta} = (\xistar+\delta)/(\Finf+\beta) = 16/21$, reducing the
framework to two integer anchors $\{\delta=2, N_0=3\}$.
We further establish a \emph{cross-group} log-Sobolev law for the
Wilson measure,
\[
\CLSI(\mu_{\mathrm{Wilson}}, G, D)
\;=\; \cinf(D)\,f(\pi_{1}(G))\,
\bigl[1-\kappa\,\delta_{\rk(G),\,C(D,2)-C(D,3)}\bigr],
\]
with $\cinf(D)=\max(0,C(D,2)-C(D,3))/(2D)$ (Bianchi cohomology,
Pilier~1 proved), $f(0)=1$ for simply-connected $G$ (SU, Sp) and
$f(\Z_2)\simeq 0.78$--$0.91$ for $G$ with $\pi_1=\Z_2$ (SO), and
$\kappa=1/6$ derived two independent ways (SU(3) root system; D=4
Hodge self-dual decomposition).
Empirical validation: 27 datapoints cross-$(N,D,G)$,
$\chi^{2}/\mathrm{dof}=0.71$, $p=0.86$, mean $|\Delta|=6.4\%$ on
Wilson channels. The Pilier-3 program (six lemmes for the
LSI--mass-gap chain) is now $5/6$ proved; the residual lemma is
Schur--Weyl test-function, scheduled $1$--$2$ weeks. The continuum
extension reduces to a single isolated statement,
\emph{Conjecture~$C^{\star}$}: exact projective consistency of
$\{\mu_{a},\rho_{a,a'}\}$ at true 't~Hooft scaling
$\beta(a)=2N^{2}/\lambda$ (currently empirical $\Delta\simeq 9.5$--$10\%$).
Cross-$N$ verification on Athenodorou--Teper 2021 data for
$\mathrm{SU}(N)$, $N\in\{2,3,4,5,6,8\}$, on a filtered 29-channel
benchmark, gives mean absolute residual $5.1\%$ with $79\%$ of
channels within $7\%$, achieved with \emph{zero free parameters}.
Three honest path probabilities (G1 inverse-limit, G2 integrable
$\beta$-function, G3 Wilson-flow Mosco) combine to
$P(\text{at least one closes in 10\,y})\simeq 75\%$.
\end{abstract}

\maketitle

\section{Introduction}\label{sec:intro}

The Clay Millennium problem on 4D Yang--Mills theory
\cite{JaffeWitten2000} divides into two layers: existence of a mass
gap $m_{\text{gap}}>0$ in the continuum $\mathrm{SU}(N)$ theory, and a
\emph{quantitative} prediction of its dimensionless ratio to
$\sqrt{\sigzero}$. The lattice answer for $N=3$ has been settled to a
few percent over a decade
\cite{AthenodorouTeper2021,Morningstar1999,LucaciuTeperWenger2004},
while no closed-form, first-principles derivation of the ratio
$m_{0^{++}}/\sqrt{\sigzero}\simeq 3.4$ had previously been written.
In this Letter we present such a closed form and complement it with
a \emph{Bianchi-cohomological cross-group law} for the Wilson
log-Sobolev constant which is universal across $(N,D,G)$ and
identifies the unique remaining technical bottleneck for the
continuum: \emph{Conjecture~$C^{\star}$} (exact projective consistency
at true 't~Hooft scaling).

\section{The three anchors}\label{sec:anchors}

\paragraph{Anchor~1: $\xistar = 2/3$ (heat kernel).}
Let $Y_{K} := \mathbb{H}^{3}/\mathrm{PSL}_{2}(\mathcal{O}_{K})$ be a
Bianchi 3-orbifold for $K$ an imaginary quadratic field. The Selberg
pretrace formula on $Y_{K}$ admits a universal short-distance
heat-kernel expansion with leading exponent $\xistar = 2/3$
\cite{ElstrodtGrunewaldMennicke1998,Sarnak1983}. In a companion
paper \cite{RemondiereXiStarCR2026} this is proved unconditionally;
the Lean~4 mechanization is in \verb|Crossed/Transport.lean|
(zero \verb|sorry|). The universal prefactor is
\begin{equation}
K^{2} \;=\; 2\pi e\,\xistar \;=\; \tfrac{4\pi e}{3},\quad
K \simeq 3.3744.
\label{eq:K-defined}
\end{equation}

\paragraph{Anchor~2: $\Finf = 9/10$ (Dijkgraaf--Witten genus).}
For $\mathrm{SU}(N)$ pure gauge, the planar genus expansion
\cite{tHooft1974} reorganized in the Dijkgraaf--Witten partition
function \cite{DijkgraafWitten1990} yields
\begin{equation}
F(N) \;=\; \Finf\!\left(1+\tfrac{1}{N^{2}}\right),
\quad \Finf = \tfrac{9}{10} = \tfrac{Z_{0}}{Z_{0}+Z_{1}}.
\label{eq:F-N}
\end{equation}
The absence of $1/N$ odd corrections distinguishes
$\mathrm{SU}(N)$ from $\mathrm{Sp}(2N)$ \cite{Bennett2021}.
$F(N)$ matches the AT2021 $N$-scan at
$\chi^{2}/\mathrm{ndf}\simeq 1.13$ with zero free parameters.

\paragraph{Anchor~3: $\delta = +2$ (flux-tube flexion).}
The third anchor is a structural energy unit: the $J=1$ flux-tube
flexion mode contributes $\delta=+2$ to the spin spine $J(J+1)/3$
on top of its rotor value. The $J=1$ channels exhibit a uniform
$\delta=+2$ boost across $N\in\{3,4,5,6,8\}$ relative to the Casimir
prediction; universality across $N$ rules out a dynamical
origin \cite{LuscherWeisz2002,LuscherWeisz2004}.

\section{Derived constants}\label{sec:derived}

The three anchors determine, by exact algebraic identities, two
additional rationals:
\begin{align}
\beta &= 2 + \Finf\xistar = \tfrac{13}{5}, \label{eq:beta-derived}\\
c_{\eta} &= \frac{\xistar+\delta}{\Finf+\beta}
            = \frac{8/3}{7/2} = \tfrac{16}{21}, \label{eq:c-eta-derived}\\
\eta_{\infty} &= \tfrac{1}{2}
                 \quad \text{(}\dim\mathfrak{so}(N)/\dim\mathfrak{su}(N)
                 \to 1/2\text{)}.
                 \label{eq:eta-inf}
\end{align}
Free fits on AT2021 return
$\beta_{\infty}=2.6429$ ($1.7\%$ of $13/5$) and
$a=0.486(14)$, $b=-0.764(40)$ in $\eta(N)=a+b/N^{2}$ ($2.8\%$ of
$1/2$ and $0.2\%$ of $-16/21$).

\section{Closed-form formula}\label{sec:closed-form}

Assembling anchors and derived constants:
\begin{widetext}
\begin{equation}
\boxed{\;
\frac{m^{2}(J,P,C,\mathrm{ex},N)}{\sigzero}
\;=\;
(2\pi e\,\xistar)\,\Finf^{2}\!\left(1+\tfrac{1}{N^{2}}\right)^{\!2}
\Bigl[\,\xistar\!\bigl(\tfrac{J(J+1)}{3}+\delta\,\delta_{J,1}\bigr)
+(\beta-P)(\mathrm{ex}+\xistar)\Bigr]
\Bigl[\,1+\bigl(\eta_{\infty}-\tfrac{c_{\eta}}{N^{2}}\bigr)\tfrac{1-C}{2}\Bigr],\;}
\label{eq:full-formula}
\end{equation}
\end{widetext}
with $\xistar=2/3$, $\Finf=9/10$, $\delta=+2$,
$\beta=13/5$, $\eta_{\infty}=1/2$, $c_{\eta}=16/21$.
The $N\to\infty$ limit has zero free parameters; $\sigzero$ is the
sole dimensional input via QCD transmutation. The L\"uscher universal
string coefficient $\pi/12 = \pi(1{-}\xistar)/\delta^{2}$ is recovered
exactly, and $T_c/\sqrt{\sigma_0}=\Finf\xistar=3/5$ reproduces
Boyd~1996 to $<1\%$.

\section{Bianchi-cohomological cross-group law}\label{sec:bianchi}

The structural backbone of the formula is a universal cross-group
law for the Wilson log-Sobolev constant, established in
\cite{RemondiereTheoremCv13_2026} (cluster firm 720, $27$
datapoints):
\begin{widetext}
\begin{equation}
\boxed{\;
\CLSI(\mu_{\mathrm{Wilson}}, G, D)
\;=\; \cinf(D)\,f(\pi_{1}(G))\,
\bigl[1 - \kappa\,\delta_{\rk(G),\,C(D,2)-C(D,3)}\bigr],
\;}
\label{eq:cross-group}
\end{equation}
\end{widetext}
with the Bianchi cohomological constant
\begin{equation}
\cinf(D) \;=\; \max\!\bigl(0,\,C(D,2)-C(D,3)\bigr)\big/(2D),
\label{eq:cinf}
\end{equation}
$f(0)=1$ for simply-connected $G$ (SU, Sp) and
$f(\Z_{2})\simeq 0.78$--$0.91$ for $\pi_{1}=\Z_{2}$ (SO);
$\kappa=1/6$ derived two independent ways
(SU(3) root system $\cap$ Casimir saturation; D=4 Hodge self-dual
$b_{2}^{+}=b_{2}^{-}=3$, ratio $(1/3)(1/2)=1/6$); and $\delta_{a,b}$
the Kronecker symbol, saturating when
$\rk(G)=\dim\mathrm{Harm}^{2}_{\mathrm{abel}}(D)$.

\paragraph{Decisive cross-group comparison.}
$\mathrm{SU}(4)$ and $\mathrm{SO}(6)$ share the algebra $A_{3}$ and
the same 't~Hooft $\beta=40$: the measured
$\CLSI=0.255$ for SU(4) matches $\cinf$, while
$\CLSI=0.195$ for SO(6) matches $f(\Z_{2})\cdot\cinf$. The
$23.5\%$ gap is attributable to the $\Z_{2}$ quotient
($\mathrm{SO}(6)=\mathrm{SU}(4)/\Z_{2}$), not to the representation or
algebra. $\mathrm{Sp}(2)$ ($\pi_{1}=0$, $\rk=2$ saturated) gives
$\CLSI=0.205\simeq \cinf\cdot 5/6$, confirming the SU/Sp branch.

\paragraph{Three universal laws cross-$D$ (1--3\%).}
\begin{align}
\CLSI(\mathrm{Haar~SU}(2), D) &= 1/(2D)
\quad (\Delta -2.7\%),\\
\CLSI(\mathrm{Haar~SU}(N{\geq}3), D) &= 2/(3D)
\quad (\Delta 1.7\%).
\end{align}
The unconditional ratio identity
\begin{equation}
\boxed{\;E[|\Phi|^{2}_{H^{-1}}]\,/\,E[|\Phi|^{2}_{L^{2}}]
= 1/(2D)\;}
\label{eq:hminus1}
\end{equation}
follows from the lattice Green function on hypercubic $\Z^{D}$.
Wilson/Haar ratios: $C_{2}-C_{3}=2$ for SU(2);
$(3/4)(C_{2}-C_{3})=3/2$ for SU($N{\geq}3$).

\paragraph{Pilier 3 status (5/6 lemmes proved).}
The chain
$c_{\infty}\to\CLSI\to\text{mass gap}$ proceeds through six lemmes:
(1.1)~Bochner--Weitzenb\"ock \emph{proved} ($95\%$);
(1.2)~Bakry--\'Emery uniform via $\beta$-metric dilatation
$g_{\mathrm{eff}}(\beta)=(1+\beta/\beta_{0})g_{0}$ with
$\beta_{0}=\cinf$ \emph{sketch} ($70\%$);
(1.3)~triple cancellation Bochner \emph{proved} ($100\%$);
(1.4)~Peter--Weyl $+$ Haar saturation via Whitehead~1937 \emph{proved}
($90\%$); (1.5)~Schur--Weyl test function \emph{sketch} ($60\%$,
finalization $1$--$2$ weeks);
(1.5bis)~$\kappa=1/6$ \emph{proved} ($95\%$, two independent
derivations).

\section{Conjecture $C^{\star}$ and the continuum}\label{sec:cstar}

The continuum extension of \eqref{eq:cross-group} reduces, in the
projective-limit (inverse-system) framework, to a single isolated
statement.

\begin{conjecture}[$C^{\star}$, exact projective consistency]
\label{conj:Cstar}
Let $\mu_{a}$ be the SU(N) Wilson measure on $\Lambda_{a}$ at
true 't~Hooft scaling $\beta(a)=2N^{2}/\lambda$, $\lambda$ fixed,
and $\rho_{a,a'}:\Omega_{a'}\to\Omega_{a}$ the block-spin
(Migdal--Kadanoff) restriction. Then
\[
(\rho_{a,a'})_{\ast}\mu_{a'} \;=\; \mu_{a}\qquad \forall\,a\succeq a'.
\]
\end{conjecture}

\noindent\emph{Status:} empirical $\Delta\simeq 9.5$--$10\%$
(scripts 165 and \texttt{kolmogorov\_v2.py}, the latter using GPU
CuPy on $L=8$, $\beta=10$, confirming $\langle P\rangle=0.84$
coherent with SU(2) strong coupling and Bałaban 1985--1990
\cite{Balaban1985}).

If Conjecture~$C^{\star}$ holds, the Kolmogorov extension theorem
yields a unique continuum measure $\mu_{\mathrm{cont}}$ on
$\mathcal{S}'(\R^{4})\otimes\mathfrak{su}(N)$, the
log-Sobolev constant descends by Fukushima--Oshima--Takeda
\cite{FukushimaOshimaTakeda1994}, and the mass gap follows
(Rothaus~1981; Otto--Villani 2000) as
$m_{\mathrm{phys}}^{2}\geq 2/\cinf(D)$.

\paragraph{Three converging paths and honest probability.}
\textbf{(G1)} Inverse-limit cohomology, conditional on $C^{\star}$;
\textbf{(G2)} LSI uniform forces integrable $\beta$-function, no
Landau pole; \textbf{(G3)} Wilson-flow Mosco at $t_{0}>0$ fixed with
Lipschitz continuity in $t_{0}$ \cite{Luscher2010,CCHS3D2024}.
Combining (with approximate path independence),
\begin{equation}
P(\text{at least one G1/G2/G3 closes in 10\,y})
\;\simeq\; 75\%.
\label{eq:p-75}
\end{equation}

\paragraph{H\_CONT finite-size and Wilson-flow tests.}
On SU(2) $D=4$ $\beta=10$, the Symanzik scaling
$\CLSI(L)=\cinf+A/L^{2}$ on $L\in\{8,12,16\}$ ($50$ configurations,
Numba-JIT) gives $\cinf^{\mathrm{fit}}=0.2402$ ($\Delta -3.9\%$).
The Wilson-flow plateau
$\CLSI(t) = 0.247 \pm 0.000$ on $t\in[0,0.1]$
(CV $<0.001$) anchors path G3.
A PySR cross-$(N,D,G)$ scan on 27 datapoints recovers
\eqref{eq:cross-group} with mean $|\Delta|=6.4\%$.

\section{Cross-$N$ verification and predictions}\label{sec:verify}

\paragraph{Verification.}
On the Athenodorou--Teper 2021 $N$-scan
\cite{AthenodorouTeper2021}, restricted to 29 channels
$(J,P,C,\mathrm{ex})$ free of ditorelon-dominated states,
\eqref{eq:full-formula} achieves mean absolute residual $5.1\%$ with
$79\%$ of channels within $7\%$ at zero free parameters; a free
4-parameter fit improves only marginally to $\sim 4.5\%$.

