Quantity & Predicted & Test \\
\midrule
$m(1^{++})_{\mathrm{SU}(3)}$ & $\simeq 2504$~MeV & new measurement \\
$\eta_{\mathrm{SU}(6)}$ & $0.479$ & $0.485$ \cite{AthenodorouTeper2021}\\
$\eta_{\mathrm{SU}(\infty)}$ & $1/2$ exactly & SU(10) extrap.\\
$\mathrm{Sp}(2N)$ ground state & $K^{2}F_{\mathrm{Sp}}^{2}\xistar$
                              & $2.5\%$ \cite{Bennett2021}\\
$\CLSI(\mathrm{SO(3)},D=4)$ & $f(\Z_{2})\cinf$ & $0.228$ (script 199)\\
\bottomrule
\end{tabular}
\end{table}

