'TubeAreaVerif.enonce_canonique_A' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeAreaVerif.enonce_canonique_B' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.wilson_column_flip_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.grid_plaq_surjective' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.grid_stokes_rectangle' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.tube_area_law_rectangle' depends on axioms: [propext, Classical.choice, Quot.sound]
TubeArea.grid_plaq_surjective : ∀ (m n : ℕ), Function.Surjective fun σ => TubeArea.plaq TubeArea.gridBd σ
@TubeArea.grid_stokes_rectangle : ∀ {m n : ℕ} (a b : Fin (m + 1)) (c d : Fin (n + 1)),
  ↑a < ↑b →
    ↑c < ↑d →
      ∀ (σ : TubeArea.GridEdge m n → ℤˣ),
        ∏ e ∈ TubeArea.rectBoundary a b c d, σ e =
          ∏ p ∈ TubeArea.rectPlaquettes a b c d, TubeArea.plaq TubeArea.gridBd σ p
@TubeArea.tube_area_law_rectangle : ∀ {G : Type u_1} {F : Type u_2} {X : Type u_3} [inst : Group G]
  [inst_1 : MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G] [inst_4 : Fintype F] [inst_5 : Fintype X] (m n : ℕ)
  (a b : Fin (m + 1)) (c d : Fin (n + 1)),
  ↑a < ↑b →
    ↑c < ↑d →
      ∀ (haarG : Measure G) [IsProbabilityMeasure haarG],
        (∀ (g : G), MeasurePreserving (fun h => g * h) haarG haarG) →
          ∀ (z : G),
            z * z = 1 →
              (∀ (g : G), z * g = g * z) →
                ∀ (chi : G → ℝ),
                  Measurable chi →
                    (∀ (g : G), |chi g| ≤ 1) →
                      (∀ (g : G), chi (z * g) = -chi g) →
                        ∀ (weights : Fin m × Fin n → F → ℝ),
                          (∀ (p : Fin m × Fin n) (y : F), |weights p y| ≤ 1) →
                            ∀ (β : ℝ),
                              0 ≤ β →
                                ∀ (R : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X → ℝ),
                                  Measurable R →
                                    (∀ (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X), 0 ≤ R ω) →
                                      (∀ (σ : TubeArea.GridEdge m n → ℤˣ)
                                          (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X),
                                          R (TubeArea.columnFlip z σ ω) = R ω) →
                                        Integrable
                                            (fun ω =>
                                              R ω *
                                                Real.exp
                                                  (∑ p, TubeArea.wilsonCoupling β weights chi TubeArea.gridWord p ω))
                                            (TubeArea.wilsonMeasure haarG) →
                                          ∀ (y0 : F),
                                            |∫ (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X),
                                                  TubeArea.wilsonLoop chi (TubeArea.rectWord a b c d) y0 ω *
                                                    (R ω *
                                                      Real.exp
                                                        (∑ p,
                                                          TubeArea.wilsonCoupling β weights chi TubeArea.gridWord p
                                                            ω)) ∂TubeArea.wilsonMeasure haarG| ≤
                                              Real.tanh (β * ↑(Fintype.card F)) ^ ((↑b - ↑a) * (↑d - ↑c)) *
                                                ∫ (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X),
                                                  R ω *
                                                    Real.exp
                                                      (∑ p,
                                                        TubeArea.wilsonCoupling β weights chi TubeArea.gridWord p
                                                          ω) ∂TubeArea.wilsonMeasure haarG
'TubeArea.neutral_word_flip_invariant' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.mixedWord_neutral' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.wilson_action_area_law_rectangle' depends on axioms: [propext, Classical.choice, Quot.sound]
@TubeArea.neutral_word_flip_invariant : ∀ {G : Type u_1} {E : Type u_2} {F : Type u_3} {X : Type u_4} [inst : Group G]
  {z : G},
  z * z = 1 →
    (∀ (g : G), z * g = g * z) →
      ∀ (q : TubeArea.GeneralWord E F X),
        TubeArea.NeutralWord q →
          ∀ (σ : E → ℤˣ) (ω : TubeArea.WilsonConfig G E F X),
            TubeArea.generalHolonomy q (TubeArea.columnFlip z σ ω) = TubeArea.generalHolonomy q ω
@TubeArea.mixedWord_neutral : ∀ {E : Type u_1} {F : Type u_2} {X : Type u_3} (e : E) (y y' : F) (x x' : X),
  TubeArea.NeutralWord (TubeArea.mixedWord e y y' x x')
@TubeArea.wilson_action_area_law_rectangle : ∀ {G : Type u_1} {F : Type u_2} {X : Type u_3} {Q : Type u_4}
  [inst : Group G] [inst_1 : MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G] [inst_4 : Fintype F]
  [inst_5 : Fintype X] [inst_6 : Fintype Q] (m n : ℕ) (a b : Fin (m + 1)) (c d : Fin (n + 1)),
  ↑a < ↑b →
    ↑c < ↑d →
      ∀ (haarG : Measure G) [IsProbabilityMeasure haarG],
        (∀ (g : G), MeasurePreserving (fun h => g * h) haarG haarG) →
          ∀ (z : G),
            z * z = 1 →
              (∀ (g : G), z * g = g * z) →
                ∀ (chi : G → ℝ),
                  Measurable chi →
                    (∀ (g : G), |chi g| ≤ 1) →
                      (∀ (g : G), chi (z * g) = -chi g) →
                        ∀ (weights : Fin m × Fin n → F → ℝ),
                          (∀ (p : Fin m × Fin n) (y : F), |weights p y| ≤ 1) →
                            ∀ (β : ℝ),
                              0 ≤ β →
                                ∀ (wq : Q → TubeArea.GeneralWord (TubeArea.GridEdge m n) F X),
                                  (∀ (q : Q), TubeArea.NeutralWord (wq q)) →
                                    ∀ (coef : Q → ℝ) (y0 : F),
                                      |∫ (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X),
                                            TubeArea.wilsonLoop chi (TubeArea.rectWord a b c d) y0 ω *
                                              (TubeArea.neutralActionWeight chi wq coef ω *
                                                Real.exp
                                                  (∑ p,
                                                    TubeArea.wilsonCoupling β weights chi TubeArea.gridWord p
                                                      ω)) ∂TubeArea.wilsonMeasure haarG| ≤
                                        Real.tanh (β * ↑(Fintype.card F)) ^ ((↑b - ↑a) * (↑d - ↑c)) *
                                          ∫ (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X),
                                            TubeArea.neutralActionWeight chi wq coef ω *
                                              Real.exp
                                                (∑ p,
                                                  TubeArea.wilsonCoupling β weights chi TubeArea.gridWord p
                                                    ω) ∂TubeArea.wilsonMeasure haarG
'TubeAreaVerif.enonce_canonique_F1' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeAreaVerif.enonce_canonique_F2' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeAreaVerif.enonce_canonique_F3' depends on axioms: [propext, Classical.choice, Quot.sound]
