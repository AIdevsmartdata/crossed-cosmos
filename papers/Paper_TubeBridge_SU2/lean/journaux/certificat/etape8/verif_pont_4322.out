'TubeAreaVerif.enonce_canonique_A' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeAreaVerif.enonce_canonique_B' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.wilson_column_flip_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.grid_plaq_surjective' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.grid_stokes_rectangle' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.tube_area_law_rectangle' depends on axioms: [propext, Classical.choice, Quot.sound]
TubeArea.grid_plaq_surjective : ∀ (m n : ℕ), Function.Surjective fun σ => TubeArea.plaq TubeArea.gridBd σ
@TubeArea.grid_stokes_rectangle : ∀ {m n : ℕ} (a b : Fin (m + 1)) (c d : Fin (n + 1)),
  ↑a < ↑b →
    ↑c < ↑d →
      ∀ (σ : TubeArea.GridEdge m n → ℤˣ),
        ∏ e ∈ TubeArea.rectBoundary a b c d, σ e =
          ∏ p ∈ TubeArea.rectPlaquettes a b c d, TubeArea.plaq TubeArea.gridBd σ p
@TubeArea.tube_area_law_rectangle : ∀ {G : Type u_1} {F : Type u_2} {X : Type u_3} [inst : Group G]
  [inst_1 : MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G] [inst_4 : Fintype F] [inst_5 : Fintype X] (m n : ℕ)
  (a b : Fin (m + 1)) (c d : Fin (n + 1)),
  ↑a < ↑b →
    ↑c < ↑d →
      ∀ (haarG : Measure G) [IsProbabilityMeasure haarG],
        (∀ (g : G), MeasurePreserving (fun h => g * h) haarG haarG) →
          ∀ (z : G),
            z * z = 1 →
              (∀ (g : G), z * g = g * z) →
                ∀ (chi : G → ℝ),
                  Measurable chi →
                    (∀ (g : G), |chi g| ≤ 1) →
                      (∀ (g : G), chi (z * g) = -chi g) →
                        ∀ (weights : Fin m × Fin n → F → ℝ),
                          (∀ (p : Fin m × Fin n) (y : F), |weights p y| ≤ 1) →
                            ∀ (β : ℝ),
                              0 ≤ β →
                                ∀ (R : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X → ℝ),
                                  Measurable R →
                                    (∀ (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X), 0 ≤ R ω) →
                                      (∀ (σ : TubeArea.GridEdge m n → ℤˣ)
                                          (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X),
                                          R (TubeArea.columnFlip z σ ω) = R ω) →
                                        Integrable
                                            (fun ω =>
                                              R ω *
                                                Real.exp
                                                  (∑ p, TubeArea.wilsonCoupling β weights chi TubeArea.gridWord p ω))
                                            (TubeArea.wilsonMeasure haarG) →
                                          ∀ (y0 : F),
                                            |∫ (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X),
                                                  TubeArea.wilsonLoop chi (TubeArea.rectWord a b c d) y0 ω *
                                                    (R ω *
                                                      Real.exp
                                                        (∑ p,
                                                          TubeArea.wilsonCoupling β weights chi TubeArea.gridWord p
                                                            ω)) ∂TubeArea.wilsonMeasure haarG| ≤
                                              Real.tanh (β * ↑(Fintype.card F)) ^ ((↑b - ↑a) * (↑d - ↑c)) *
                                                ∫ (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X),
                                                  R ω *
                                                    Real.exp
                                                      (∑ p,
                                                        TubeArea.wilsonCoupling β weights chi TubeArea.gridWord p
                                                          ω) ∂TubeArea.wilsonMeasure haarG
'TubeArea.neutral_word_flip_invariant' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.mixedWord_neutral' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.wilson_action_area_law_rectangle' depends on axioms: [propext, Classical.choice, Quot.sound]
@TubeArea.neutral_word_flip_invariant : ∀ {G : Type u_1} {E : Type u_2} {F : Type u_3} {X : Type u_4} [inst : Group G]
  {z : G},
  z * z = 1 →
    (∀ (g : G), z * g = g * z) →
      ∀ (q : TubeArea.GeneralWord E F X),
        TubeArea.NeutralWord q →
          ∀ (σ : E → ℤˣ) (ω : TubeArea.WilsonConfig G E F X),
            TubeArea.generalHolonomy q (TubeArea.columnFlip z σ ω) = TubeArea.generalHolonomy q ω
@TubeArea.mixedWord_neutral : ∀ {E : Type u_1} {F : Type u_2} {X : Type u_3} (e : E) (y y' : F) (x x' : X),
  TubeArea.NeutralWord (TubeArea.mixedWord e y y' x x')
@TubeArea.wilson_action_area_law_rectangle : ∀ {G : Type u_1} {F : Type u_2} {X : Type u_3} {Q : Type u_4}
  [inst : Group G] [inst_1 : MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G] [inst_4 : Fintype F]
  [inst_5 : Fintype X] [inst_6 : Fintype Q] (m n : ℕ) (a b : Fin (m + 1)) (c d : Fin (n + 1)),
  ↑a < ↑b →
    ↑c < ↑d →
      ∀ (haarG : Measure G) [IsProbabilityMeasure haarG],
        (∀ (g : G), MeasurePreserving (fun h => g * h) haarG haarG) →
          ∀ (z : G),
            z * z = 1 →
              (∀ (g : G), z * g = g * z) →
                ∀ (chi : G → ℝ),
                  Measurable chi →
                    (∀ (g : G), |chi g| ≤ 1) →
                      (∀ (g : G), chi (z * g) = -chi g) →
                        ∀ (weights : Fin m × Fin n → F → ℝ),
                          (∀ (p : Fin m × Fin n) (y : F), |weights p y| ≤ 1) →
                            ∀ (β : ℝ),
                              0 ≤ β →
                                ∀ (wq : Q → TubeArea.GeneralWord (TubeArea.GridEdge m n) F X),
                                  (∀ (q : Q), TubeArea.NeutralWord (wq q)) →
                                    ∀ (coef : Q → ℝ) (y0 : F),
                                      |∫ (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X),
                                            TubeArea.wilsonLoop chi (TubeArea.rectWord a b c d) y0 ω *
                                              (TubeArea.neutralActionWeight chi wq coef ω *
                                                Real.exp
                                                  (∑ p,
                                                    TubeArea.wilsonCoupling β weights chi TubeArea.gridWord p
                                                      ω)) ∂TubeArea.wilsonMeasure haarG| ≤
                                        Real.tanh (β * ↑(Fintype.card F)) ^ ((↑b - ↑a) * (↑d - ↑c)) *
                                          ∫ (ω : TubeArea.WilsonConfig G (TubeArea.GridEdge m n) F X),
                                            TubeArea.neutralActionWeight chi wq coef ω *
                                              Real.exp
                                                (∑ p,
                                                  TubeArea.wilsonCoupling β weights chi TubeArea.gridWord p
                                                    ω) ∂TubeArea.wilsonMeasure haarG
'TubeAreaVerif.enonce_canonique_F1' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeAreaVerif.enonce_canonique_F2' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeAreaVerif.enonce_canonique_F3' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeAreaVerif.enonce_canonique_F4' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeAreaVerif.enonce_canonique_G1' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeAreaVerif.enonce_canonique_G2' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeAreaVerif.enonce_canonique_G3' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.wilson_twist_ratio_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeArea.wilson_electric_flux_torus' depends on axioms: [propext, Classical.choice, Quot.sound]
@TubeArea.wilson_twist_ratio_bound : ∀ {G : Type u_1} {E : Type u_2} {F : Type u_3} {X : Type u_4} {P : Type u_5}
  [inst : Group G] [inst_1 : MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G] [inst_4 : Fintype E]
  [inst_5 : DecidableEq E] [inst_6 : Fintype F] [inst_7 : Fintype X] [inst_8 : Fintype P] [inst_9 : DecidableEq P]
  (haarG : Measure G) [IsProbabilityMeasure haarG],
  (∀ (g : G), MeasurePreserving (fun h => g * h) haarG haarG) →
    ∀ (z : G),
      z * z = 1 →
        (∀ (g : G), z * g = g * z) →
          ∀ (chi : G → ℝ),
            Measurable chi →
              (∀ (g : G), |chi g| ≤ 1) →
                (∀ (g : G), chi (z * g) = -chi g) →
                  ∀ (w : P → List (E × Bool)),
                    (∀ (p : P), (List.map Prod.fst (w p)).Nodup) →
                      ∀ (c : P → F → ℝ),
                        (∀ (p : P) (y : F), |c p y| ≤ 1) →
                          ∀ (β : ℝ),
                            0 ≤ β →
                              ∀ (R : TubeArea.WilsonConfig G E F X → ℝ),
                                Measurable R →
                                  (∀ (ω : TubeArea.WilsonConfig G E F X), 0 ≤ R ω) →
                                    (∀ (σ : E → ℤˣ) (ω : TubeArea.WilsonConfig G E F X),
                                        R (TubeArea.columnFlip z σ ω) = R ω) →
                                      Integrable (fun ω => R ω * Real.exp (∑ p, TubeArea.wilsonCoupling β c chi w p ω))
                                          (TubeArea.wilsonMeasure haarG) →
                                        (∀ (σ : E → ℤˣ),
                                            ∏ p, TubeArea.plaq (fun p => TubeArea.wordBoundary (w p)) σ p = 1) →
                                          (∀ (t : P → ℤˣ),
                                              ∏ p, t p = 1 →
                                                ∃ σ,
                                                  ∀ (p : P),
                                                    TubeArea.plaq (fun p => TubeArea.wordBoundary (w p)) σ p = t p) →
                                            ∀ (p₀ : P),
                                              |∫ (ω : TubeArea.WilsonConfig G E F X),
                                                      R ω *
                                                        Real.exp
                                                          (∑ p,
                                                            TubeArea.wilsonCoupling β c chi w p
                                                              ω) ∂TubeArea.wilsonMeasure haarG -
                                                    ∫ (ω : TubeArea.WilsonConfig G E F X),
                                                      R ω *
                                                        Real.exp
                                                          (∑ p,
                                                            TubeArea.wilsonCoupling β
                                                              (fun p y => if p = p₀ then -c p y else c p y) chi w p
                                                              ω) ∂TubeArea.wilsonMeasure haarG| ≤
                                                Real.tanh (β * ↑(Fintype.card F)) ^ Fintype.card P *
                                                  (∫ (ω : TubeArea.WilsonConfig G E F X),
                                                      R ω *
                                                        Real.exp
                                                          (∑ p,
                                                            TubeArea.wilsonCoupling β c chi w p
                                                              ω) ∂TubeArea.wilsonMeasure haarG +
                                                    ∫ (ω : TubeArea.WilsonConfig G E F X),
                                                      R ω *
                                                        Real.exp
                                                          (∑ p,
                                                            TubeArea.wilsonCoupling β
                                                              (fun p y => if p = p₀ then -c p y else c p y) chi w p
                                                              ω) ∂TubeArea.wilsonMeasure haarG)
@TubeArea.wilson_electric_flux_torus : ∀ {G : Type u_1} {F : Type u_2} {X : Type u_3} {Q : Type u_4} [inst : Group G]
  [inst_1 : MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G] [inst_4 : Fintype F] [inst_5 : Fintype X]
  [inst_6 : Fintype Q] (m n : ℕ),
  2 ≤ m →
    2 ≤ n →
      ∀ (haarG : Measure G) [IsProbabilityMeasure haarG],
        (∀ (g : G), MeasurePreserving (fun h => g * h) haarG haarG) →
          ∀ (z : G),
            z * z = 1 →
              (∀ (g : G), z * g = g * z) →
                ∀ (chi : G → ℝ),
                  Measurable chi →
                    (∀ (g : G), |chi g| ≤ 1) →
                      (∀ (g : G), chi (z * g) = -chi g) →
                        ∀ (weights : Fin m × Fin n → F → ℝ),
                          (∀ (p : Fin m × Fin n) (y : F), |weights p y| ≤ 1) →
                            ∀ (β : ℝ),
                              0 ≤ β →
                                ∀ (wq : Q → TubeArea.GeneralWord (TubeArea.TorusEdge m n) F X),
                                  (∀ (q : Q), TubeArea.NeutralWord (wq q)) →
                                    ∀ (coef : Q → ℝ) (p₀ : Fin m × Fin n),
                                      |∫ (ω : TubeArea.WilsonConfig G (TubeArea.TorusEdge m n) F X),
                                              TubeArea.neutralActionWeight chi wq coef ω *
                                                Real.exp
                                                  (∑ p,
                                                    TubeArea.wilsonCoupling β weights chi TubeArea.torusWord p
                                                      ω) ∂TubeArea.wilsonMeasure haarG -
                                            ∫ (ω : TubeArea.WilsonConfig G (TubeArea.TorusEdge m n) F X),
                                              TubeArea.neutralActionWeight chi wq coef ω *
                                                Real.exp
                                                  (∑ p,
                                                    TubeArea.wilsonCoupling β
                                                      (fun p y => if p = p₀ then -weights p y else weights p y) chi
                                                      TubeArea.torusWord p ω) ∂TubeArea.wilsonMeasure haarG| ≤
                                        Real.tanh (β * ↑(Fintype.card F)) ^ (m * n) *
                                          (∫ (ω : TubeArea.WilsonConfig G (TubeArea.TorusEdge m n) F X),
                                              TubeArea.neutralActionWeight chi wq coef ω *
                                                Real.exp
                                                  (∑ p,
                                                    TubeArea.wilsonCoupling β weights chi TubeArea.torusWord p
                                                      ω) ∂TubeArea.wilsonMeasure haarG +
                                            ∫ (ω : TubeArea.WilsonConfig G (TubeArea.TorusEdge m n) F X),
                                              TubeArea.neutralActionWeight chi wq coef ω *
                                                Real.exp
                                                  (∑ p,
                                                    TubeArea.wilsonCoupling β
                                                      (fun p y => if p = p₀ then -weights p y else weights p y) chi
                                                      TubeArea.torusWord p ω) ∂TubeArea.wilsonMeasure haarG)
@TubeArea.torusWord : {m n : ℕ} → Fin m × Fin n → List (TubeArea.TorusEdge m n × Bool)
'TubeBridge.signedWilsonEnergy_one' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeBridge.openai_wilson_twist_ratio' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeBridge.openai_wilson_twist_ratio_family' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeBridge.su2_neg_one_mem' depends on axioms: [propext, Classical.choice, Quot.sound]
'TubeBridge.openai_su2_twist_ratio' depends on axioms: [propext, Classical.choice, Quot.sound]
TubeBridge.openai_wilson_twist_ratio : ∀ (g : YangMills.GaugeGroup),
  -1 ∈ g.image →
    ∀ (l : ℕ+),
      2 ≤ ↑l →
        ∀ (β : ℝ),
          0 ≤ β →
            ∀ (haar : Measure ↥g.image) [IsProbabilityMeasure haar],
              (∀ (u : ↥g.image), MeasurePreserving (fun v => u * v) haar haar) →
                ∀ (a b : ZMod ↑l),
                  |(∫ (U : YangMills.Configuration g l),
                          Real.exp (-β * YangMills.wilsonEnergy U) ∂Measure.pi fun x => haar) -
                        ∫ (U : YangMills.Configuration g l),
                          Real.exp
                            (-β *
                              TubeBridge.signedWilsonEnergy (TubeBridge.planeTwist a b) U) ∂Measure.pi fun x => haar| ≤
                    Real.tanh (β * ↑↑l ^ 2) ^ ↑l ^ 2 *
                      ((∫ (U : YangMills.Configuration g l),
                          Real.exp (-β * YangMills.wilsonEnergy U) ∂Measure.pi fun x => haar) +
                        ∫ (U : YangMills.Configuration g l),
                          Real.exp
                            (-β *
                              TubeBridge.signedWilsonEnergy (TubeBridge.planeTwist a b) U) ∂Measure.pi fun x => haar)
TubeBridge.openai_su2_twist_ratio : ∀ (C : YangMills.WilsonFamily YangMills.su2) (l : ℕ+),
  2 ≤ ↑l →
    ∀ (β : ℝ),
      0 ≤ β →
        ∀ (a b : ZMod ↑l),
          |(∫ (U : YangMills.Configuration YangMills.su2 l),
                  Real.exp (-β * YangMills.wilsonEnergy U) ∂Measure.pi fun x => C.haar) -
                ∫ (U : YangMills.Configuration YangMills.su2 l),
                  Real.exp
                    (-β * TubeBridge.signedWilsonEnergy (TubeBridge.planeTwist a b) U) ∂Measure.pi fun x => C.haar| ≤
            Real.tanh (β * ↑↑l ^ 2) ^ ↑l ^ 2 *
              ((∫ (U : YangMills.Configuration YangMills.su2 l),
                  Real.exp (-β * YangMills.wilsonEnergy U) ∂Measure.pi fun x => C.haar) +
                ∫ (U : YangMills.Configuration YangMills.su2 l),
                  Real.exp
                    (-β * TubeBridge.signedWilsonEnergy (TubeBridge.planeTwist a b) U) ∂Measure.pi fun x => C.haar)
'YangMills.su2Theory' depends on axioms: [propext, Classical.choice, Quot.sound]
RC=0
