@TubeArea.wilson_column_flip_bound : ∀ {G : Type u_1} {E : Type u_2} {F : Type u_3} {X : Type u_4} {P : Type u_5}
  [inst : Group G] [inst_1 : MeasurableSpace G] [MeasurableMul₂ G] [MeasurableInv G] [inst_4 : Fintype E]
  [inst_5 : DecidableEq E] [inst_6 : Fintype F] [inst_7 : Fintype X] [inst_8 : Fintype P] [DecidableEq P]
  (haarG : Measure G) [IsProbabilityMeasure haarG],
  (∀ (g : G), MeasurePreserving (fun h => g * h) haarG haarG) →
    ∀ (z : G),
      z * z = 1 →
        (∀ (g : G), z * g = g * z) →
          ∀ (chi : G → ℝ),
            Measurable chi →
              (∀ (g : G), |chi g| ≤ 1) →
                (∀ (g : G), chi (z * g) = -chi g) →
                  ∀ (w : P → List (E × Bool)),
                    (∀ (p : P), (List.map Prod.fst (w p)).Nodup) →
                      ∀ (c : P → F → ℝ),
                        (∀ (p : P) (y : F), |c p y| ≤ 1) →
                          ∀ (β : ℝ),
                            0 ≤ β →
                              ∀ (R : TubeArea.WilsonConfig G E F X → ℝ),
                                Measurable R →
                                  (∀ (ω : TubeArea.WilsonConfig G E F X), 0 ≤ R ω) →
                                    (∀ (σ : E → ℤˣ) (ω : TubeArea.WilsonConfig G E F X),
                                        R (TubeArea.columnFlip z σ ω) = R ω) →
                                      Integrable (fun ω => R ω * Real.exp (∑ p, TubeArea.wilsonCoupling β c chi w p ω))
                                          (TubeArea.wilsonMeasure haarG) →
                                        ∀ (wC : List (E × Bool)),
                                          (List.map Prod.fst wC).Nodup →
                                            ∀ (y0 : F) (A : Finset P),
                                              (∀ (σ : E → ℤˣ),
                                                  ∏ e ∈ TubeArea.wordBoundary wC, σ e =
                                                    ∏ p ∈ A, TubeArea.plaq (fun p => TubeArea.wordBoundary (w p)) σ p) →
                                                (Function.Surjective fun σ =>
                                                    TubeArea.plaq (fun p => TubeArea.wordBoundary (w p)) σ) →
                                                  |∫ (ω : TubeArea.WilsonConfig G E F X),
                                                        TubeArea.wilsonLoop chi wC y0 ω *
                                                          (R ω *
                                                            Real.exp
                                                              (∑ p,
                                                                TubeArea.wilsonCoupling β c chi w p
                                                                  ω)) ∂TubeArea.wilsonMeasure haarG| ≤
                                                    Real.tanh (β * ↑(Fintype.card F)) ^ #A *
                                                      ∫ (ω : TubeArea.WilsonConfig G E F X),
                                                        R ω *
                                                          Real.exp
                                                            (∑ p,
                                                              TubeArea.wilsonCoupling β c chi w p
                                                                ω) ∂TubeArea.wilsonMeasure haarG
