default(parisize, "4G");
default(realprecision, 200);
E = ellinit([0, 0, 0, 0, -1]);
om = abs(real(E.omega[1]));
mf = mfinit([12, 5, -3], 0);
F = mfeigenbasis(mf);
f = F[1];
print("LMFDB-style label: 12.5.b.a (level 12, weight 5, char chi_-3 orbit b)");
print("a_2..a_30 = ", mfcoefs(f, 30));
Lf = lfunmf(mf, f);
Lv = lfun(Lf, 2);
printf("\nL(f,2) = %.150Pf\n\n", Lv);
printf("Omega = %.150Pf\n\n", om);
alpha = Lv * Pi^2 / om^4;
printf("alpha = L*pi^2/Omega^4 = %.150Pf\n\n", alpha);
printf("3/8 = %.150Pf\n\n", 3.0/8);
printf("alpha - 3/8 = %.30Pe\n", alpha - 3.0/8);
printf("ratio*8/3 = %.30Pf\n", alpha * 8 / 3);
quit;
